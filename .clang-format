# Code style for futoshiki-solver.
# Docs: https://clang.llvm.org/docs/ClangFormatStyleOptions.html

BasedOnStyle: LLVM
Language: Cpp          # clang-format's C mode uses the Cpp language settings

IndentWidth: 4
TabWidth: 4
UseTab: Never

ColumnLimit: 100
BreakBeforeBraces: Linux   # function braces on a new line, control braces at line end
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false

PointerAlignment: Left     # int *p
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements

KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
IndentCaseLabels: true
